# ============================================
# AI Virtual Try-On — Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# --- Inference Device ---
# Options: auto, mps, cpu
INFERENCE_DEVICE=auto

# --- Hugging Face ---
# Only needed if downloading gated models
HUGGINGFACE_TOKEN=

# --- Model Configuration ---
# Override default models (leave empty for defaults)
POSE_MODEL=mediapipe
SEGMENTATION_MODEL=mediapipe
HUMAN_PARSING_MODEL=schp
GARMENT_PROCESSOR_MODEL=rembg
TRYON_MODEL=geometric

# --- LLM Integration (Optional) ---
# OmniRoute-compatible endpoint
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Processing ---
# Max image dimension for inference (smaller = faster)
MAX_INFERENCE_SIZE=512
# JPEG quality for results (0-100)
RESULT_QUALITY=90

# --- Privacy ---
# Delete temp files after processing
AUTO_DELETE_TEMP=true
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
